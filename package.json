{
  "name": "goodfirsttoken",
  "version": "0.0.0",
  "private": true,
  "description": "Spend your spare AI tokens on open source issues that maintainers tagged for outside help.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "pnpm --parallel --filter @goodfirsttoken/github-fake --filter @goodfirsttoken/web dev",
    "seed": "pnpm --filter @goodfirsttoken/github-fake seed && node apps/web/scripts/seed-local.mjs",
    "test": "node --test \"scripts/**/*.test.mjs\" \"apps/web/scripts/*.test.mjs\" && pnpm -r test",
    "test:e2e": "pnpm --filter @goodfirsttoken/web test:e2e",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "check": "pnpm lint && pnpm typecheck && pnpm skills:check",
    "prototype": "node scripts/serve.mjs prototype",
    "skills:build": "node scripts/skills.mjs build",
    "skills:check": "node scripts/skills.mjs check",
    "video:stills": "node video/capture.mjs stills",
    "video:render": "node video/capture.mjs render"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "playwright": "^1.63.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
