# Local settings for `pnpm dev`. pnpm dev works without this file. To change
# a value, copy this file to .dev.vars, which git ignores.
#
# Every variable the app reads is listed here with a safe local default.
# Staging and production get theirs from the GitHub environment when they
# deploy, as docs/self-hosting.md describes. Secrets go up with
# `wrangler secret put`.

# The environment the Worker runs as: development, staging, or production.
# /healthz reports it.
ENVIRONMENT=development

# The domain the site is served on, and other domains, separated by commas,
# that redirect to it. Leave both empty locally, so nothing redirects.
PRIMARY_DOMAIN=
REDIRECT_DOMAINS=

# The client ID of the GitHub OAuth app sign-in uses, and the numeric GitHub
# IDs of admins, separated by commas. The client ID is the GitHub fake's app.
OAUTH_CLIENT_ID=goodfirsttoken-local
ADMIN_GITHUB_IDS=

# Sign-in's two secrets: the OAuth app's client secret, and the secret that
# signs sign-in cookies and encrypts stored GitHub tokens. Leave both out
# locally. With neither set, and GitHub the fake on this machine, sign-in uses
# the fake's client secret and a public stand-in (src/auth/settings.ts), and
# Wrangler's warning that they are missing is expected. Setting one turns the
# stand-ins off, so set both or neither. To sign in with a real GitHub OAuth
# app, set both, with its client ID above and the GitHub URLs below left
# empty.
# OAUTH_CLIENT_SECRET=
# AUTH_SECRET=

# The read-only token the scheduled jobs in src/sync/, the policy crawler in
# src/crawl/, and a maintainer's refresh read public GitHub data with. Leave
# it out locally. Without it the jobs read nothing, and the log says so.
# `pnpm dev` doesn't run them on a schedule.
# GH_SERVICE_TOKEN=

# GitHub's REST and GraphQL API, and github.com itself for sign-in. The
# defaults point at the GitHub fake that `pnpm dev` starts. Left empty, the
# app calls https://api.github.com and https://github.com, which is what a
# deploy gets when its GitHub environment doesn't set them.
GH_API_URL=http://127.0.0.1:8944/api
GH_WEB_URL=http://127.0.0.1:8944
