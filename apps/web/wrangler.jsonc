// The Worker's config for local development.
//
// This file holds bindings and settings only, with local names. The names of
// deployed resources, account and resource IDs, custom domains, and secrets
// never go here. scripts/deploy-config.mjs writes the staging and production
// config from the GitHub environment when the deploy workflow runs, as
// docs/self-hosting.md describes. Local development needs none of it.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "web",
  "main": "src/server.ts",
  // Unit tests run on the workerd that @cloudflare/vitest-pool-workers pins,
  // which can be older than the one dev and preview use. A date newer than
  // it supports makes `pnpm test` fail, so move this only as far as it allows.
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  // Every variable the Worker reads, with its local value. A deploy sets
  // ENVIRONMENT to staging or production, and each other one from the GitHub
  // environment setting of the same name, so no local value reaches a
  // deployed Worker. GitHub reserves names that start with GITHUB_, so none
  // of these can.
  "vars": {
    "ENVIRONMENT": "development",
    "PRIMARY_DOMAIN": "",
    "REDIRECT_DOMAINS": "",
    // The GitHub fake's OAuth app. A deploy sets the environment's own.
    "OAUTH_CLIENT_ID": "goodfirsttoken-local",
    "ADMIN_GITHUB_IDS": "",
    // GitHub's API and github.com, pointing at the GitHub fake that
    // `pnpm dev` starts (packages/github-fake). A deploy that leaves them
    // empty calls https://api.github.com and https://github.com
    // (src/github.ts).
    "GH_API_URL": "http://127.0.0.1:8944/api",
    "GH_WEB_URL": "http://127.0.0.1:8944"
  },
  // The Worker's secrets, which a deploy puts with `wrangler secret put`.
  // OAUTH_CLIENT_SECRET is the GitHub OAuth app's client secret. AUTH_SECRET
  // signs the sign-in cookies and encrypts the GitHub tokens the site stores,
  // from its own sign-in and from each agent's. Local development needs
  // neither (src/auth/settings.ts). GH_SERVICE_TOKEN is the read-only token
  // the jobs below read public GitHub data with. Without it they read
  // nothing.
  "secrets": { "required": ["OAUTH_CLIENT_SECRET", "AUTH_SECRET", "GH_SERVICE_TOKEN"] },
  // The cron triggers. Each names one job in src/sync/scheduled.ts: the
  // tagged-issue sync every 15 minutes, the PR job twice an hour, apart
  // from it, the policy crawler's search once an hour, apart from both, and
  // ending the agents' connections whose grants ran out once a day, apart
  // from all three. Times are UTC.
  "triggers": { "crons": ["*/15 * * * *", "7,37 * * * *", "52 * * * *", "23 4 * * *"] },
  "d1_databases": [{ "binding": "DB", "database_name": "db" }],
  // One issue room per issue, named by the issue (src/rooms/issue-room.ts),
  // and one feed each for the homepage, each project, and each person
  // (src/rooms/feed.ts). Class names are code, so they may be here. Each
  // class gets its storage from a migration, which is never edited once it
  // has run on a deploy. A new class is a new migration with the next tag.
  "durable_objects": {
    "bindings": [
      { "name": "ISSUE_ROOM", "class_name": "IssueRoom" },
      { "name": "FEED", "class_name": "Feed" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["IssueRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["Feed"] }
  ],
  // The OAuth library's clients, grants, and token hashes, for the MCP
  // server (src/mcp/provider.ts).
  "kv_namespaces": [{ "binding": "OAUTH_KV" }],
  "queues": {
    "producers": [
      { "binding": "FEED_QUEUE", "queue": "feed" },
      { "binding": "CRAWL_QUEUE", "queue": "crawl" }
    ],
    // The feed queue's consumer (src/feed/queue.ts). What these settings
    // mean for a line on its way to the feeds is under Live feeds in
    // docs/how-it-works.md. src/feed/queue.ts sets the wait for each message
    // it asks for again. retry_delay is the wait for a batch that fails as a
    // whole. max_retries keeps the last retry well inside the time the queue
    // keeps a message, so a message that fails every time reaches the
    // dead-letter queue.
    "consumers": [
      {
        "queue": "feed",
        "max_batch_size": 100,
        "max_batch_timeout": 1,
        "max_retries": 90,
        "retry_delay": 30,
        "dead_letter_queue": "feed-dlq"
      },
      // The crawl queue's consumer (src/crawl/queue.ts), which reads
      // GitHub. One batch at a time, since GitHub asks for one call at a
      // time from a token. src/crawl/queue.ts sends the repos that wait for
      // the budget back as a new message, which takes none of a message's
      // tries, and sets the wait for a message it asks for again, at most
      // an hour. max_retries keeps the last retry inside the time the queue
      // keeps a message, as for the feed.
      {
        "queue": "crawl",
        "max_batch_size": 5,
        "max_batch_timeout": 30,
        "max_concurrency": 1,
        "max_retries": 90,
        "retry_delay": 300,
        "dead_letter_queue": "crawl-dlq"
      }
    ]
  },
  // Cloudflare rate limiting. SIGN_IN_LIMITER counts sign-ins on the site and
  // agents' sign-ins to the MCP server, per client address
  // (src/auth/rate-limit.ts). TOKEN_LIMITER counts requests to the MCP
  // server's token endpoint, per client address, apart from sign-ins, since
  // one host can refresh tokens for many people's agents. MCP_LIMITER counts
  // calls to the MCP server, per person (src/mcp/server.ts). STREAM_LIMITER
  // counts opening a live text stream or a page's live socket, per client
  // address (src/feed/streams.ts). Wrangler needs a namespace ID for each, so
  // these are placeholders that local development simulates. A deploy
  // replaces each with the <name>_NAMESPACE_ID setting.
  "ratelimits": [
    { "name": "SIGN_IN_LIMITER", "namespace_id": "1", "simple": { "limit": 20, "period": 60 } },
    { "name": "MCP_LIMITER", "namespace_id": "2", "simple": { "limit": 120, "period": 60 } },
    { "name": "TOKEN_LIMITER", "namespace_id": "3", "simple": { "limit": 600, "period": 60 } },
    { "name": "STREAM_LIMITER", "namespace_id": "4", "simple": { "limit": 60, "period": 60 } }
  ]
}
