{
  "name": "@goodfirsttoken/web",
  "version": "0.0.0",
  "private": true,
  "description": "The Good First Token site, API, and MCP server, as one Cloudflare Worker.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "postinstall": "wrangler types --strict-vars=false",
    "types": "wrangler types --strict-vars=false",
    "dev": "node scripts/migrate-local.mjs && vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "wrangler types --strict-vars=false --check && tsc --noEmit && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.1.0",
    "@goodfirsttoken/core": "workspace:*",
    "@modelcontextprotocol/server": "2.1.0",
    "@takumi-rs/wasm": "2.14.0",
    "@tanstack/react-router": "^1.170.39",
    "@tanstack/react-start": "^1.168.58",
    "better-auth": "1.7.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.60.2",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@goodfirsttoken/github-fake": "workspace:*",
    "@modelcontextprotocol/client": "2.1.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.1",
    "vitest": "~4.1.11",
    "wrangler": "^4.141.0"
  }
}
